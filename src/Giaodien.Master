<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Giaodien.master.cs" Inherits="Webchiasecongthucnauan.Giaodien" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
      <nav class="navbar navbar-expand-sm bg-dark navbar-dark sticky-top">
            <div class="container">
                <a class="navbar-brand" href="Default.aspx">Bếp Nhà</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="collapsibleNavbar">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" href="Default.aspx">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" href="Default.aspx">Danh mục</a></li>
                    </ul>
                    
                    <!-- MENU PHÂN QUYỀN TÀI KHOẢN -->
                    <ul class="navbar-nav align-items-center">
                        <!-- Hiển thị khi CHƯA ĐĂNG NHẬP (Khách) -->
                        <asp:Panel ID="pnlChuaDangNhap" runat="server">
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" href="DangNhap.aspx">Đăng nhập</a>
                            </li>
                        </asp:Panel>

                        <!-- Hiển thị khi ĐÃ ĐĂNG NHẬP -->
                        <asp:Panel ID="pnlDaDangNhap" runat="server" Visible="false" CssClass="d-flex align-items-center">
                            <li class="nav-item me-3">
                                <span class="text-light">Xin chào, <b class="text-info"><asp:Label ID="lblUser" runat="server"></asp:Label></b></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-info fw-bold" href="DanhSachMon.aspx">Quản lý món của tôi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" href="ThemCongThuc.aspx">+ Thêm món mới</a>
                            </li>
                            <li class="nav-item ms-2">
                                <asp:Button ID="btnDangXuat" runat="server" Text="Đăng xuất" CssClass="btn btn-sm btn-outline-danger" OnClick="btnDangXuat_Click" />
                            </li>
                        </asp:Panel>
                    </ul>
                </div>
            </div>
        </nav>
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <footer class="bg-dark text-white text-center py-4 mt-5">
            <div class="container">
                <p class="mb-0">© 2026 Đồ án Chuyên đề ASP.NET - Thực hiện bởi Võ Thanh Phong.</p>
            </div>
        </footer>
    </form>
</body>
</html>
